# ── .env.example (버릴지도) ───────────────────────────────────
# 이 파일은 «어떤 키가 필요한지» 만 보여 줍니다. 같은 폴더(저장소 맨 위)에 .env 로 복사해 값을 채웁니다.
# ⚠️ .env 는 .gitignore 되어 있습니다. 토큰을 코드 · 커밋 · 슬랙 메시지에 넣지 마세요.

# ── 필수 ──
SLACK_BOT_TOKEN=xoxb-...          # 보내는 선 (chat:write)
SLACK_APP_TOKEN=xapp-...          # 받는 선 (Socket Mode)

# ── 선택 — LangSmith 추적 (11-25 부터 제출 요건 아님 · 켜 두면 검색 · 생성 단계를 화면으로 볼 수 있음) ──
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true            # false 거나 없으면 trace 가 남지 않습니다 (봇은 그대로 돎)
# LANGSMITH_AGENT_ID · LANGSMITH_AGENT_ENVIRONMENT (수업 7주차 실습)는 있어도 config.py 가 무시합니다

# LANGSMITH_PROJECT 는 넣지 않습니다 — config.py 가 «recycle-bot-20241499» 로 정합니다
#   (수업 저장소에서 .env 를 다른 주차 실습과 같이 쓸 때 trace 가 섞이지 않게 정한 방식)
# MODEL · EMBED_MODEL 은 이 프로젝트가 읽지 않습니다 — 수업 저장소에서 쓰던 .env 를 그대로 복사해 와도 됩니다.

# ── (선택) 바꿔서 잴 때만 — 없으면 코드 기본값 ──
# RECYCLE_MODEL=gemma4:e4b                                 # 생성 (답). 비교용 수업 기본은 gemma3:4b (인덱스 재생성 불필요)
# RECYCLE_EMBED_MODEL=hf.co/mykor/KURE-v1-gguf:Q8_0        # 임베딩. 바꾸면 python build_index.py 를 다시
# RECYCLE_STRATEGY=basic                                   # basic | multiquery
# RECYCLE_YEAR_BONUS=0                                     # year >= 2020 문서의 거리에서 빼 줄 값
# RECYCLE_PROMPT=base                                      # base | recent
# RECYCLE_INDEX=index_recycle                              # 인덱스 폴더 이름
# RECYCLE_LANGSMITH_PROJECT=recycle-bot-20241499
# RECYCLE_REASONING=off                                    # off | on | auto — 생각(thinking) 모드. qwen3.5 는 기본이 켜짐이라 끈다
# ── 📷 사진으로 묻기 ──
# RECYCLE_VISION_MODEL=qwen3.5:4b                          # 사진에 품목 이름을 붙이는 모델. RECYCLE_MODEL 과 같게 주면 한 모델로
# RECYCLE_PHOTO_MODE=pick                                  # pick: 문서 품목 목록에서 고름 | free: 이름을 지어냄
# RECYCLE_PHOTO_SIDE=768                                   # 사진 긴 변을 이 픽셀까지 줄여 넣는다
# RECYCLE_PHOTO_MAX_DIST=0                                 # 1위 거리가 이보다 멀면 되묻기 (0 = 끔)
# RECYCLE_PHOTO_MIN_GAP=0                                  # 다른 품목 후보와의 거리 차가 이보다 작으면 되묻기 (0 = 끔)
